{
  "expo": {
    "name": "Elifba Kids",
    "slug": "elifba-kids",
    "version": "1.0.0",
    "description": "Kinder-Lern-App für die Buchstaben des Korans (Elifba).",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "elifbakids",
    "userInterfaceStyle": "light",
    "primaryColor": "#0F766E",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.elifba.kids",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.elifba.kids",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F0FDFA"
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7d25913e-25ba-4e7e-b2ec-e071816931bc"
      }
    },
    "owner": "kclk08"
  }
}
